ANTHROPIC_API_KEY=
CRUSTDATA_API_KEY=
# Required. Cheapest to costliest: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
AGENT_MODEL=claude-sonnet-5-5
# EMAIL_MODEL=claude-haiku-5-5   # writes the per-person line in invite emails
# Form server (uv run forms). FORMS_BASE_URL is what invite links point to: set it to your public tunnel URL for real invites.
FORMS_BASE_URL=http://localhost:8000
# AGENT_DB=data/agent.db   # chat history (uv run web)
# FORMS_DB=data/forms.db
# Contact enrich (business emails) isn't enabled on our key yet; mock it until Crustdata turns it on.
CRUSTDATA_MOCK_CONTACT_ENRICH=true
# Mocked emails go to plus-addresses of this inbox (never to real people). Unset -> <slug>@mock.invalid
MOCK_EMAIL_INBOX=
# Email. EMAIL_MODE=log (default) only records emails in the survey's outbox; EMAIL_MODE=resend sends them.
EMAIL_MODE=log
RESEND_API_KEY=
# A sender on a domain verified in Resend. Without one, use onboarding@resend.dev (delivers only to your Resend account email).
EMAIL_FROM=Verified Research <research@yourdomain.com>
EMAIL_REPLY_TO=
# Optional safety net: only these recipients get real email (comma-separated addresses or @domains).
EMAIL_ALLOWLIST=
# Response quality review of open text. With a TypeSafe key, Jev judges relevance, specificity, gibberish,
# machine-written text and profile fit; without one, a small Claude model does (QUALITY_MODEL).
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# QUALITY_REVIEWER=auto   # auto | jev | claude
